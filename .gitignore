.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
# setuptools-Artefakt: eine veraltete Kopie des ganzen Pakets, inklusive des
# 30-MB-Modells, das direkt daneben ausgeschlossen ist. Kostete 35 MB je Klon.
build/
dist/

# Laufzeitdaten und Testartefakte
data/
data-e2e*/
tests/data/
*.sqlite
*.sqlite-*

# Videos: gross und persoenlich, gehoeren nicht ins Repo
*.MOV
*.mov
*.mp4

# Web
web/node_modules/
web/.next/
web/.next-broken-*/
web/out/
web/test-results/
web/playwright-report/
web/build.log
web/tsconfig.tsbuildinfo
web/*.png

# Nur das "full"-Modell liegt im Repo. "heavy" (30 MB) laedt man bei Bedarf
# nach; die Fehlermeldung in pose.py nennt die URL.
jumpheightcalculator/models/pose_landmarker_heavy.task
